public class Bicycle implements Methods {

    private int seats;

    Bicycle(int seats){
        this.seats = seats;
    }

    @Override
    public void sound(){
        System.out.println("trrrrrrrr");
    }

    @Override
    public void wheels(){
        System.out.println("2 wheels");
    }

    @Override
    public void model(){
        System.out.println("BMX");
    }

    @Override
    public int getSeats(){
        return seats;
    }
} 
